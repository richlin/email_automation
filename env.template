# Email Automation - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required: OpenAI API key for AI-powered email classification
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom configuration directory for Gmail authentication
# Default: ./temp_data (relative to project root)
# GMAIL_AUTH_CONFIG_DIR=/path/to/your/config/directory

# Optional: Custom Gmail credentials file path
# Default: ./credentials.json (relative to project root)
# GMAIL_CREDENTIALS_FILE=/path/to/your/credentials.json

# Optional: OpenAI model to use for classification
# Default: gpt-4 (recommended for best results)
# Alternative: gpt-3.5-turbo (faster, cheaper, but less accurate)
# OPENAI_MODEL=gpt-4

# Optional: Maximum number of emails to fetch and process
# Default: 200
# MAX_EMAILS=200

# Optional: Temperature setting for OpenAI API (0.0 to 2.0)
# Default: 0.1 (more deterministic responses)
# OPENAI_TEMPERATURE=0.1

# Optional: Maximum tokens for OpenAI API responses
# Default: 1000
# OPENAI_MAX_TOKENS=1000

# Optional: Enable debug logging
# Default: false
# DEBUG=false

# Optional: Custom categories file path
# Default: ./configs/email_categories.json
# CUSTOM_CATEGORIES_FILE=/path/to/your/categories.json
