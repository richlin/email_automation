# Email Automation - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required: OpenAI API key for AI-powered email classification
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Custom configuration directory for Gmail authentication
GMAIL_AUTH_CONFIG_DIR=./gmail_auth

# Custom Gmail credentials file path
GMAIL_CREDENTIALS_FILE=./credentials.json 

# OpenAI model to use for classification
OPENAI_MODEL=gpt-4.1-mini

# Maximum number of emails to fetch and process
MAX_EMAILS=200

# Temperature setting for OpenAI API (0.0 to 2.0)
OPENAI_TEMPERATURE=0.1

# Maximum tokens for OpenAI API responses
OPENAI_MAX_TOKENS=1000
